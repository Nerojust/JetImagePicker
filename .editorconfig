root = true

[*.{kt,kts}]
# Jetpack Compose convention: @Composable functions are PascalCase (they behave like factories
# for UI), which conflicts with ktlint's default lowerCamelCase function-naming rule.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose convention: files exposing a single top-level `remember*` composable function are
# named after that function (lowerCamelCase), not PascalCase like a class file.
ktlint_standard_filename = disabled
